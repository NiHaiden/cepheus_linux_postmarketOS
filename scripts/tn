#!/bin/sh
# Run one command in the postmarketOS *initramfs debug shell* (telnet :23).
# Only available when boot failed and the initramfs dropped into its debug shell.
#   T=6 scripts/tn 'tail -40 /pmOS_init.log'
. "$(dirname "$0")/common.sh"
{ sleep 1; printf '%s\n' "$*"; sleep "${T:-4}"; } | nc -w 20 "$PHONE_IP" 23 2>/dev/null \
  | LC_ALL=C tr -d '\r' | LC_ALL=C sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' \
  | LC_ALL=C sed '1,/^Run .pmos_logdump/d' | LC_ALL=C grep -av "^'setup_usb\|^You can expose"
