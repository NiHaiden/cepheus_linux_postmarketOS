@@ -94,7 +95,7 @@ package() {
 
 sha512sums="
 c1bdb11a9ad8be826ec5781e239c60ad92d6bb3a2d6b0adff8ef1f1e334bc6889ab91683257691ba3155f976011cd37969be379d509c9f928f4f85753e95635e  linux-v7.0.0-sm8150.tar.gz
-fb70f1898267e93a39c818da24fb2b0670dca76fb5c49680274417d9ff63ab15ecbe05e63db42c414cef36256a44a02f064e123012b2f461315d107aa12685c7  config-postmarketos-qcom-sm8150.aarch64
+17591db8fa80ab3ee9c9edeb8b0a8344448ce785551d1767ace08382022cc87bfc090fac711ef5032460a297664d72544a936b9bd4d79c501dcdc8203c732827  config-postmarketos-qcom-sm8150.aarch64
 316decafef4528b3d8fa9ce1f2c1588048ae0a99adf088d61372d84ff95ae7bf58e5cc0d03d73201f1735f3d523468d98113ac575714930229434a46385a5c3d  0001-enable-ufs.patch
 a75ad54e77870170a1e33bd8ec68bfa64542791f1c9383da6335f0e7f5da14f10e9fe267d58a3ade8e04d7eb3d82e5ca2354b52b2fa0d363c9bb6d5bec860ba8  0002-libbpf-Fix-UAF-in-strset__add_str.patch
 7b62e50cc3277361bd941e2aa63ccc9922aaf86deec3519c584eee5f04f059c0a812e6a5f51575928270bf749860d5707da29b1b0a2440e8918c7cf8c37e1bd3  0003-xiaomi-vayu-fix-otg.patch
@@ -105,4 +106,5 @@ d88b27d002ef59b68ef79490899ef0a738016a13fcec492195b68761112a394b38c7632fa5a42652
 8e40f3b0c9f6de2cf9875b47391b609183180d37f462a5746a5f46579d4ce69ee30f01bd86430453cf1d8041540829d0acc3cc9acd5899f1c03fee6d9d4bf87f  0008-cepheus-battery.patch
