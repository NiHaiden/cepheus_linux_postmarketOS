From 9fe9dc96ead9d3ba6ad70c21252038ec3286f1bb Mon Sep 17 00:00:00 2001
From: cepheus <cepheus@local>
Date: Wed, 28 Oct 2026 19:47:29 +0000
Subject: [PATCH] cepheus: Bluetooth (WCN3998 on uart13, bootmac for BD
 address); kernel localversion -sm8150-aurora

---
 .../90-bootmac-wifi.rules                     |  2 +
 device/testing/device-xiaomi-cepheus/APKBUILD |  7 +-
 .../0011-cepheus-bluetooth.patch              | 86 +++++++++++++++++++
 .../linux-postmarketos-qcom-sm8150/APKBUILD   |  6 +-
 .../config-postmarketos-qcom-sm8150.aarch64   |  2 +-
 5 files changed, 98 insertions(+), 5 deletions(-)
 create mode 100644 device/testing/device-xiaomi-cepheus/90-bootmac-wifi.rules
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8150/0011-cepheus-bluetooth.patch

diff --git a/device/testing/device-xiaomi-cepheus/90-bootmac-wifi.rules b/device/testing/device-xiaomi-cepheus/90-bootmac-wifi.rules
new file mode 100644
index 0000000000..84d6c01da0
--- /dev/null
+++ b/device/testing/device-xiaomi-cepheus/90-bootmac-wifi.rules
@@ -0,0 +1,2 @@
+# Masks bootmac's wlan rule: the WCN3990 Wi-Fi already gets its real MAC from the modem.
+# bootmac is only wanted for Bluetooth (the controller has no BD address of its own).
diff --git a/device/testing/device-xiaomi-cepheus/APKBUILD b/device/testing/device-xiaomi-cepheus/APKBUILD
index 22a193984d..d1d2040ddd 100644
--- a/device/testing/device-xiaomi-cepheus/APKBUILD
+++ b/device/testing/device-xiaomi-cepheus/APKBUILD
@@ -3,19 +3,20 @@ maintainer="Alexey Minnekhanov <alexeymin@postmarketos.org>"
 pkgname=device-xiaomi-cepheus
 pkgdesc="Xiaomi Mi 9"
 pkgver=7
-pkgrel=0
+pkgrel=1
 url="https://postmarketos.org"
 license="MIT"
 arch="aarch64"
 options="!check !archcheck"
 depends="
 	linux-postmarketos-qcom-sm8150
+	bootmac
 	mkbootimg
 	postmarketos-base
 "
 makedepends="devicepkg-dev"
 subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
-source="deviceinfo kernel-cmdline.conf"
+source="deviceinfo kernel-cmdline.conf 90-bootmac-wifi.rules"
 
 build() {
 	devicepkg_build $startdir $pkgname
@@ -23,6 +24,7 @@ build() {
 
 package() {
 	devicepkg_package $startdir $pkgname
+	install -Dm644 "$srcdir"/90-bootmac-wifi.rules -t "$pkgdir"/etc/udev/rules.d/
 }
 
 nonfree_firmware() {
@@ -34,4 +36,5 @@ nonfree_firmware() {
 sha512sums="
 ffc4240164815cba73fc24adb5f959d9aed7a99726b335bb38aaf377645986ebb28e678eaa5ade4b346a902f22724bbbb89f3c2a167e0a5599adbcddbd46cb10  deviceinfo
 42d3a47ebc8109fc3bf1ac03ddae6254ca9bc7b0a64f58cfe652b30a40bdceddf09fd65a46fddeda0138d8b52dbccc2425da06f7705373f4a4ab0babaa35b150  kernel-cmdline.conf
+2297f9bf350893e9f4cca12aeee8e1f1120d56a24fe01e324728148be164a833716d81f3b576965fe234a233f15513a003b718cc80484bb990e47a3a74cff2c7  90-bootmac-wifi.rules
 "
diff --git a/device/testing/linux-postmarketos-qcom-sm8150/0011-cepheus-bluetooth.patch b/device/testing/linux-postmarketos-qcom-sm8150/0011-cepheus-bluetooth.patch
new file mode 100644
index 0000000000..17c1b351d0
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8150/0011-cepheus-bluetooth.patch
@@ -0,0 +1,86 @@
+diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
+index 4b48ee75c..678d308cb 100644
+--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
++++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
+@@ -39,7 +39,9 @@ / {
+ 	compatible = "xiaomi,cepheus", "qcom,sm8150";
+ 
+ 	aliases {
++		bluetooth0 = &bluetooth;
+ 		serial0 = &uart2;
++		hsuart0 = &uart13;
+ 		display0 = &framebuffer;
+ 	};
+ 
+@@ -719,6 +721,46 @@ ts_active: ts-active-state {
+ 		bias-pull-up;
+ 	};
+ 
++	/* downstream qupv3_se13_4uart (sm8150-pinctrl.dtsi) */
++	qup_uart13_default: qup-uart13-default-state {
++		cts-rx-pins {
++			pins = "gpio43", "gpio46";
++			function = "qup13";
++			drive-strength = <2>;
++			bias-disable;
++		};
++
++		rts-pins {
++			pins = "gpio44";
++			function = "qup13";
++			drive-strength = <2>;
++			bias-pull-down;
++		};
++
++		tx-pins {
++			pins = "gpio45";
++			function = "qup13";
++			drive-strength = <2>;
++			bias-pull-up;
++		};
++	};
++
++	qup_uart13_sleep: qup-uart13-sleep-state {
++		cts-rts-pins {
++			pins = "gpio43", "gpio44";
++			function = "gpio";
++			drive-strength = <2>;
++			bias-pull-down;
++		};
++
++		tx-rx-pins {
++			pins = "gpio45", "gpio46";
++			function = "gpio";
++			drive-strength = <2>;
++			bias-pull-up;
++		};
++	};
++
+ 	ai_key_pin_a: ai-key-pin-active {
+ 		pins = "gpio97";
+ 		function = "gpio";
+@@ -732,6 +774,24 @@ &uart2 {
+ 	status = "okay";
+ };
+ 
++&uart13 {
++	pinctrl-0 = <&qup_uart13_default>;
++	pinctrl-1 = <&qup_uart13_sleep>;
++	pinctrl-names = "default", "sleep";
++
++	status = "okay";
++
++	/* WCN3998, same as raphael; downstream bt_wcn3990 supplies: core l7a, pa l2c, ldo l11c */
++	bluetooth: bluetooth {
++		compatible = "qcom,wcn3998-bt";
++		vddio-supply = <&vreg_l7a_1p8>;
++		vddxo-supply = <&vreg_l7a_1p8>;
++		vddrf-supply = <&vreg_l2c_1p3>;
++		vddch0-supply = <&vreg_l11c_3p3>;
++		max-speed = <3200000>;
++	};
++};
++
+ &usb_1 {
+ 	status = "okay";
+ };
diff --git a/device/testing/linux-postmarketos-qcom-sm8150/APKBUILD b/device/testing/linux-postmarketos-qcom-sm8150/APKBUILD
index d8bad86408..395ab7a343 100644
