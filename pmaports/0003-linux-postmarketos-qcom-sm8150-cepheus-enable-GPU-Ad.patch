 .../linux-postmarketos-qcom-sm8150/APKBUILD   |  4 +++-
 2 files changed, 27 insertions(+), 1 deletion(-)
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8150/0006-cepheus-gpu.patch

diff --git a/device/testing/linux-postmarketos-qcom-sm8150/0006-cepheus-gpu.patch b/device/testing/linux-postmarketos-qcom-sm8150/0006-cepheus-gpu.patch
