 sha512sums="
 ffc4240164815cba73fc24adb5f959d9aed7a99726b335bb38aaf377645986ebb28e678eaa5ade4b346a902f22724bbbb89f3c2a167e0a5599adbcddbd46cb10  deviceinfo
 42d3a47ebc8109fc3bf1ac03ddae6254ca9bc7b0a64f58cfe652b30a40bdceddf09fd65a46fddeda0138d8b52dbccc2425da06f7705373f4a4ab0babaa35b150  kernel-cmdline.conf
diff --git a/device/testing/linux-postmarketos-qcom-sm8150/0005-cepheus-remoteprocs-wifi.patch b/device/testing/linux-postmarketos-qcom-sm8150/0005-cepheus-remoteprocs-wifi.patch
new file mode 100644
index 0000000000..9153930488
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-sm8150/0005-cepheus-remoteprocs-wifi.patch
@@ -0,0 +1,42 @@
+From: niklas <niklas@local>
+Subject: [PATCH] arm64: dts: qcom: sm8150-xiaomi-cepheus: enable remoteprocs and WiFi
+
+Enable MPSS, ADSP and CDSP with the stock firmware names (served from the
+modem/vendor partitions by msm-firmware-loader) and the WCN3990 WiFi with
+the same supplies as raphael. Board data: stock bdwlan.bin (board_id 0xff).
+
+---
+diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
+index 9f780f446..bafd6ce3a 100644
+--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
++++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
+@@ -659,3 +659,29 @@ &mdss_dsi0_phy {
+ 	vdds-supply = <&vreg_l5a_0p875>;
+ 	status = "okay";
+ };
++
++/* Firmware is used in place from the modem/vendor partitions (msm-firmware-loader) */
++&remoteproc_adsp {
++	firmware-name = "adsp.mdt";
++	status = "okay";
++};
++
++&remoteproc_cdsp {
++	firmware-name = "cdsp.mdt";
++	status = "okay";
++};
++
++&remoteproc_mpss {
++	firmware-name = "modem.mdt";
++	status = "okay";
++};
++
++&wifi {
++	vdd-0.8-cx-mx-supply = <&vreg_l1a_0p75>;
++	vdd-1.8-xo-supply = <&vreg_l7a_1p8>;
++	vdd-1.3-rfa-supply = <&vreg_l2c_1p3>;
++	vdd-3.3-ch0-supply = <&vreg_l11c_3p3>;
++	vdd-3.3-ch1-supply = <&vreg_l10c_3p3>;
++	qcom,calibration-variant = "xiaomi_cepheus";
++	status = "okay";
++};
diff --git a/device/testing/linux-postmarketos-qcom-sm8150/APKBUILD b/device/testing/linux-postmarketos-qcom-sm8150/APKBUILD
