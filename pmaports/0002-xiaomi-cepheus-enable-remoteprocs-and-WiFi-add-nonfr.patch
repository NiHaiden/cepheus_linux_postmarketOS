 build() {
@@ -24,6 +25,12 @@ package() {
 	devicepkg_package $startdir $pkgname
 }
 
+nonfree_firmware() {
+	pkgdesc="Modem, DSP and WiFi firmware (used in place from the stock partitions)"
+	depends="msm-firmware-loader qrtr tqftpserv rmtfs"
+	mkdir "$subpkgdir"
+}
