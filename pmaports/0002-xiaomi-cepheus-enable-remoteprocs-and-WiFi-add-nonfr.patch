 .../0005-cepheus-remoteprocs-wifi.patch       | 42 +++++++++++++++++++
 .../linux-postmarketos-qcom-sm8150/APKBUILD   |  4 +-
 3 files changed, 53 insertions(+), 2 deletions(-)
 create mode 100644 device/testing/linux-postmarketos-qcom-sm8150/0005-cepheus-remoteprocs-wifi.patch

diff --git a/device/testing/device-xiaomi-cepheus/APKBUILD b/device/testing/device-xiaomi-cepheus/APKBUILD
index be65dd3aac..22a193984d 100644
