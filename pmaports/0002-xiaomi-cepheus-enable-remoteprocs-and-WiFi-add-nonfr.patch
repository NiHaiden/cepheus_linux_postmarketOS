 cbed3fac96e21d0dead253b86eceff0f9b92c6326bf187e548e615e042786732408e28a69a3c5037e97eacab7f30d1df7b33d1eb9a670066644d7b5777187119  0004-cepheus-ufs-vcc-and-display.patch
+cd06618bd1e0d7c7b45caa8b848416011d7a9728e4395aff6d1e8864a5b182f65d1be1aceb82c61872dea11970975a35253572171a06a1ed7de2ddee9d05c90a  0005-cepheus-remoteprocs-wifi.patch
