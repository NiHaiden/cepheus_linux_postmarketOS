--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
@@ -74,6 +74,16 @@ disp_vci_vreg: disp-vci-regulator {
 		regulator-boot-on;
 	};
 
+	/* touch_vddio_vreg in downstream cepheus-sm8150.dtsi */
+	touch_vddio_vreg: touch-vddio-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "touch_vddio_vreg";
+		gpio = <&tlmm 84 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <4000>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
 	gpio_keys {
 		compatible = "gpio-keys";
 		pinctrl-names = "default";
@@ -526,6 +536,10 @@ vdd_boost_en_pin: vdd-boost-en-pin {
 	};
 };
 
+&qupv3_id_2 {
+	status = "okay";
+};
+
 &pon {
 	mode-recovery = <0x1>;
 	mode-bootloader = <0x2>;
@@ -561,6 +575,13 @@ panel_te_pin: panel-te-state {
 		bias-pull-down;
 	};
 
+	ts_active: ts-active-state {
+		pins = "gpio122", "gpio12";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
 	ai_key_pin_a: ai-key-pin-active {
 		pins = "gpio97";
 		function = "gpio";
@@ -664,6 +685,39 @@ &gmu {
 	status = "okay";
 };
 
+&gpi_dma2 {
+	status = "okay";
+};
+
+&i2c17 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/* ST FTM5, downstream fts@49 in cepheus-sm8150.dtsi; driver: fts_touch (ftm5_i2c) */
+	touchscreen@49 {
+		compatible = "st,fts";
+		reg = <0x49>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <122 IRQ_TYPE_LEVEL_LOW>;
+
+		vdd-supply = <&touch_vddio_vreg>;
+		avdd-supply = <&vreg_l1c_1p8>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ts_active>;
+
+		st,irq-gpio = <&tlmm 122 GPIO_ACTIVE_HIGH>;
+		st,reset-gpio = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+		st,regulator_dvdd = "vdd";
+		st,regulator_avdd = "avdd";
+		st,max-coords = <1079 2339>;
+		/* the IC keeps its own firmware; no .ftb on this phone */
+		st,disable-auto-fw-update;
+		/* Xiaomi's FW keeps MP flag 00 and rejects saving it; AFE versions already match */
+		st,ignore-mp-flag;
+	};
+};
+
 &gpu {
 	status = "okay";
 };
