From: niklas <niklas@local>
Subject: [PATCH] arm64: dts: qcom: sm8150-xiaomi-cepheus: fix UFS VCC, enable display

- UFS: the Mi 9 has UFS 2.1 (WDC, ufsid 0x145). l10a min 2.504V is a UFS 3.0
  level; the link never comes up ("link startup failed"). Use 2.95V like
  downstream.
- Display: Samsung AMS639RQ08 module (EA8076 DDIC), same panel as raphael.
  VCI from tlmm 21, reset tlmm 6, TE tlmm 8, vddio l14a.

---
diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
index c6dd8b11b..9f780f446 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-cepheus.dts
@@ -64,6 +64,16 @@ framebuffer: framebuffer@9c000000 {
 		};
 	};
 
+	disp_vci_vreg: disp-vci-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "disp_vci_vreg";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		gpio = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
 	gpio_keys {
 		compatible = "gpio-keys";
 		pinctrl-names = "default";
@@ -312,7 +322,7 @@ vreg_l9a_1p2: ldo9 {
 		};
 
 		vreg_l10a_2p5: ldo10 {
-			regulator-min-microvolt = <2504000>;
+			regulator-min-microvolt = <2950000>;
 			regulator-max-microvolt = <2960000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 			regulator-name = "pm8150_l10a_2p5";
@@ -537,6 +547,20 @@ &tlmm {
 	/* gpios 0..3 are NFC spi, gpios 126..129 are FP spi */
 	gpio-reserved-ranges = <0 4>, <126 4>;
 
+	panel_reset_pin: panel-reset-state {
+		pins = "gpio6";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	panel_te_pin: panel-te-state {
+		pins = "gpio8";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
 	ai_key_pin_a: ai-key-pin-active {
 		pins = "gpio97";
 		function = "gpio";
@@ -598,3 +622,40 @@ &ufs_mem_phy {
     /* Schematic: VREG_L3C_1P2 */
     vdda-pll-supply = <&vreg_l3c_1p2>;
 };
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l3c_1p2>;
+	status = "okay";
+
+	panel: panel@0 {
+		compatible = "samsung,ams639rq08";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l14a_1p8>;
+		vdd3p3-supply = <&disp_vci_vreg>;
+		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&panel_reset_pin &panel_te_pin>;
+		pinctrl-names = "default";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p875>;
+	status = "okay";
+};
